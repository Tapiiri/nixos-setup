#!/usr/bin/env python3
from __future__ import annotations

import sys


def _bootstrap() -> None:
    """Bootstrap sys.path so `scripts_py.*` imports work.

    This wrapper is designed to be runnable from the repo checkout and also when
    symlinked into ~/.local/bin.
    """

    from pathlib import Path

    here = Path(__file__).resolve()
    sys.path.insert(0, str(here.parent.parent))

    from scripts_py.utils import RepoMarkers, bootstrap_repo_import_path

    bootstrap_repo_import_path(
        script_file=here,
        markers=RepoMarkers(),
        extra_candidates=(Path.cwd(),),
    )


def main() -> int:
    _bootstrap()
    from scripts_py.cli.ensure_cachix_cache import main as impl_main

    return int(impl_main(sys.argv[1:]))


if __name__ == "__main__":
    raise SystemExit(main())
